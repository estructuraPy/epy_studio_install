{
  "config_id": "install_artifacts",
  "version": "2.0.0",
  "description": "The public executables ePy Studio installs. Public and private artifacts live in SEPARATE sites by design.",
  "audit_status": "verified",
  "site": "public",
  "layout": {
    "apps": "apps/<id>/<id>.exe",
    "crafts": "crafts/<binary>/<binary>.exe (+ <binary>-cli.exe)"
  },
  "apps": [
    {
      "id": "epy_reports",
      "exe": "epy_reports.exe",
      "component": "reports"
    },
    {
      "id": "epy_slides",
      "exe": "epy_slides.exe",
      "component": "slides"
    },
    {
      "id": "epy_papers",
      "exe": "epy_papers.exe",
      "component": "papers"
    }
  ],
  "crafts": [
    {
      "id": "epy_cadcraft",
      "binary": "cadcraft",
      "files": [
        "cadcraft.exe",
        "cadcraft-cli.exe"
      ],
      "component": "craft_cadcraft",
      "upstream": "github.com/storytold/cadcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_photocraft",
      "binary": "photocraft",
      "files": [
        "photocraft.exe",
        "photocraft-cli.exe"
      ],
      "component": "craft_photocraft",
      "upstream": "github.com/storytold/photocraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_lightcraft",
      "binary": "lightcraft",
      "files": [
        "lightcraft.exe",
        "lightcraft-cli.exe"
      ],
      "component": "craft_lightcraft",
      "upstream": "github.com/storytold/lightcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_filmcraft",
      "binary": "filmcraft",
      "files": [
        "filmcraft.exe",
        "filmcraft-cli.exe"
      ],
      "component": "craft_filmcraft",
      "upstream": "github.com/storytold/filmcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_vectorcraft",
      "binary": "vectorcraft",
      "files": [
        "vectorcraft.exe",
        "vectorcraft-cli.exe"
      ],
      "component": "craft_vectorcraft",
      "upstream": "github.com/storytold/vectorcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_pdfcraft",
      "binary": "pdfcraft",
      "files": [
        "pdfcraft.exe",
        "pdfcraft-cli.exe"
      ],
      "component": "craft_pdfcraft",
      "upstream": "github.com/storytold/pdfcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_deckcraft",
      "binary": "deckcraft",
      "files": [
        "deckcraft.exe",
        "deckcraft-cli.exe"
      ],
      "component": "craft_deckcraft",
      "upstream": "github.com/storytold/deckcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_gridcraft",
      "binary": "gridcraft",
      "files": [
        "gridcraft.exe",
        "gridcraft-cli.exe"
      ],
      "component": "craft_gridcraft",
      "upstream": "github.com/storytold/gridcraft — MIT OR Apache-2.0"
    },
    {
      "id": "epy_soundcraft",
      "binary": "soundcraft",
      "files": [
        "soundcraft.exe",
